    // 5x5 Matrix constructed from your exact image output
    char matrix[5][5] = {
        {'R', 'O', 'Y', 'A', 'L'},
        {'N', 'E', 'W', 'Z', 'D'},
        {'V', 'B', 'C', 'F', 'G'},
        {'H', 'I', 'K', 'M', 'P'},
