    // Ciphertext from Experiment 9
    vector<string> cipherBlocks = {
        "KXJEY", "UREBE", "ZWEHE", "WRYTU", "HEYFS",
        "KREHE", "GOYFI", "WTTTU", "OLKSY", "CAJPO",
        "BOTEI", "ZONEW", "BYBNT", "GONEY", "CUZWR", 
        "GDSON", "SXBOU", "YWRHE", "BAAHY", "USEDQ"
    };
    
    // Concatenate the message into a single string
    string fullCiphertext = "";
    for (const string &block : cipherBlocks) {
        fullCiphertext += block;
    }
    
    cout << "--- Playfair Decryption Program ---" << endl;
    cout << "Ciphertext: " << fullCiphertext << endl;
    
    string decryptedText = decryptPlayfair(fullCiphertext, matrix);
    cout << "\nDecrypted Text (Raw): " << decryptedText << endl;
    
    return 0;
}
